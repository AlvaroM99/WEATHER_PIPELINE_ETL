[flake8]
max-line-length = 100
max-complexity = 15
select = E,F,W,C90
ignore = E501,W503,E203,E266,E402,C901,W291,W293,F541
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    htmlcov,
    build,
    dist,
    *.egg-info,
    .eggs,
    migrations,
    .pytest_cache,
    .mypy_cache

per-file-ignores =
    __init__.py: F401
    tests/*: S101,F401,F811,F841,E722
    conftest.py: F401,F811
    src/extractor.py: F401,F841
    src/loader.py: F401
    src/transformer.py: F841,E722
    src/data_quality/validators.py: F401
    src/data_quality/expectations.py: F401
    src/weather_utils/debug_utils.py: F401
    src/weather_utils/minio_client.py: F401

statistics = True
count = True
show-source = True
