# ============================================================================
# Production Environment Configuration
# ============================================================================
# ⚠️  IMPORTANT: This file contains sensitive production credentials
# ⚠️  DO NOT commit this file to version control
# ⚠️  Store these secrets in a secure secrets manager (GitHub Secrets, Vault, etc.)
# ============================================================================

# Environment
ENVIRONMENT=production

# PostgreSQL DWH
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=weather_user_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=weather_db_prod

# PostgreSQL Airflow
AIRFLOW_DB_USER=airflow_prod
AIRFLOW_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
AIRFLOW_DB_NAME=airflow_prod

# Airflow Admin
AIRFLOW_USER=admin_prod
AIRFLOW_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
AIRFLOW_EMAIL=admin@production.example.com

# MinIO
MINIO_ROOT_USER=minio_prod
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
MINIO_ENDPOINT=minio:9000

# API Keys (production keys with higher rate limits)
OPENWEATHER_API_KEY=CHANGE_ME_PRODUCTION_KEY
AEMET_API_KEY=CHANGE_ME_PRODUCTION_KEY
OPENMETEO_API_KEY=CHANGE_ME_PRODUCTION_KEY

# GitHub Token (for fetching city data)
GITHUB_TOKEN=CHANGE_ME_GITHUB_TOKEN

# Database Pool (Higher for production)
DB_POOL_MIN_CONN=5
DB_POOL_MAX_CONN=50

# Logging (JSON structured for production)
ENABLE_JSON_LOGGING=true

# Rate Limiting (Respect production API limits)
RATE_LIMIT_OPENWEATHER_MAX_CALLS=60
RATE_LIMIT_OPENWEATHER_PERIOD_SECONDS=60
RATE_LIMIT_OPENMETEO_MAX_CALLS=10
RATE_LIMIT_OPENMETEO_PERIOD_SECONDS=1
RATE_LIMIT_AEMET_MAX_CALLS=60
RATE_LIMIT_AEMET_PERIOD_SECONDS=60

# Airflow Configuration
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__METRICS__STATSD_ON=True

# Security
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_FERNET_KEY

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring
MONITORING_ENABLED=true
ALERT_EMAIL=alerts@production.example.com

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
