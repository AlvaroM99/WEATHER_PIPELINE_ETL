[run]
source = src
omit =
    */tests/*
    */conftest.py
    */__pycache__/*
    */site-packages/*
    */config/__init__.py
    */utils/__init__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
show_missing = True
skip_covered = False

[html]
directory = tests/htmlcov
