# ============================================================================
# Development Environment Configuration
# ============================================================================

# Environment
ENVIRONMENT=development

# PostgreSQL DWH
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_pass_dev
POSTGRES_DB=weather_db_dev

# PostgreSQL Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev
AIRFLOW_DB_NAME=airflow_dev

# Airflow Admin
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin_dev
AIRFLOW_EMAIL=admin@dev.local

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@dev.local
PGADMIN_DEFAULT_PASSWORD=admin_dev

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_ENDPOINT=minio:9000

# API Keys (use test/free tier keys for development)
OPENWEATHER_API_KEY=your_dev_openweather_key
AEMET_API_KEY=your_dev_aemet_key
OPENMETEO_API_KEY=your_dev_openmeteo_key

# GitHub Token (for fetching city data)
GITHUB_TOKEN=your_github_token

# Database Pool (Lower for development)
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10

# Logging (Human-readable for development)
ENABLE_JSON_LOGGING=false

# Rate Limiting (More permissive for development)
RATE_LIMIT_OPENWEATHER_MAX_CALLS=60
RATE_LIMIT_OPENWEATHER_PERIOD_SECONDS=60
RATE_LIMIT_OPENMETEO_MAX_CALLS=20
RATE_LIMIT_OPENMETEO_PERIOD_SECONDS=1
RATE_LIMIT_AEMET_MAX_CALLS=60
RATE_LIMIT_AEMET_PERIOD_SECONDS=60

# Airflow Configuration
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
