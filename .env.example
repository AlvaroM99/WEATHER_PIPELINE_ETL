# PostgreSQL Database Configuration
POSTGRES_USER=weatheruser
POSTGRES_PASSWORD=Weather2024!Secure
POSTGRES_DB=weatherdb

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@weather.com
PGADMIN_DEFAULT_PASSWORD=PgAdmin2024!

# Airflow Configuration
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=Airflow2024!

# OpenWeatherMap API Key
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MinIO Configuration (Data Lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinIO2024!Secure
MINIO_ENDPOINT=minio:9000

# AEMET API Configuration (Spanish Meteorological Service)
# Get your API key from: https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=your_aemet_api_key_here

# Open-Meteo API Configuration (optional, not required for basic usage)
# Get your API key from: https://open-meteo.com/en/pricing (optional)
OPENMETEO_API_KEY=
