# PostgreSQL Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_weather_password_here
POSTGRES_DB=weatherdb

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# Airflow Configuration
AIRFLOW_USER=your_airflow_user
AIRFLOW_PASSWORD=your_airflow_password_here

# Airflow Metadata Database (separate from DWH)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# OpenWeatherMap API Key
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MinIO Configuration (Data Lake)
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=minio:9000

# AEMET API Configuration (Spanish Meteorological Service)
# Get your API key from: https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=your_aemet_api_key_here

# OpenMeteo API Key
# Get your API key from: https://openmeteo.com/api
OPENMETEO_API_KEY=your_openmeteo_api_key_here

# ============================================================================
# NEW: Code Quality Improvements Configuration
# ============================================================================

# Database Connection Pool Configuration
# Adjust based on Airflow parallelism and workload
# Formula: (airflow_workers * tasks_per_worker) + buffer
DB_POOL_MIN_CONN=2        # Minimum connections to keep alive
DB_POOL_MAX_CONN=20       # Maximum connections (was 5, increased to 20)

# Environment: development, staging, production
ENVIRONMENT=development

# Logging Configuration
# Set to "true" to enable JSON structured logging (recommended for production)
# Set to "false" for human-readable logs (recommended for development)
ENABLE_JSON_LOGGING=false

# Rate Limiting Configuration (Optional - overrides defaults)
# OpenWeatherMap: 60 calls/minute (free tier)
# RATE_LIMIT_OPENWEATHER_MAX_CALLS=60
# RATE_LIMIT_OPENWEATHER_PERIOD_SECONDS=60.0

# Open-Meteo: 10 calls/second (recommended to be respectful)
# RATE_LIMIT_OPENMETEO_MAX_CALLS=10
# RATE_LIMIT_OPENMETEO_PERIOD_SECONDS=1.0

# AEMET: 60 calls/minute (official limit)
# RATE_LIMIT_AEMET_MAX_CALLS=60
# RATE_LIMIT_AEMET_PERIOD_SECONDS=60.0

# ============================================================================
# NEW: Continuous Deployment Configuration
# ============================================================================

# GitHub Token (for CI/CD workflows)
GITHUB_TOKEN=your_github_token_here

# Airflow Email (for admin user)
AIRFLOW_EMAIL=admin@example.com

# Airflow Security (production only)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
# AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# Monitoring & Alerts
ALERT_EMAIL=alerts@example.com

# Slack Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
