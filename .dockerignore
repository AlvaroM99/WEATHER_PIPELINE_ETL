# ============================================================================
# .dockerignore - Exclude files from Docker build context
# ============================================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
tests/htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/

# Documentation
*.md
!README.md
docs/

# Environment files (sensitive data)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Data files (handled separately in volumes)
data/
*.csv
*.json
*.parquet

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup

# Airflow specific (will be created at runtime)
airflow.cfg
airflow.db
airflow-webserver.pid
logs/
